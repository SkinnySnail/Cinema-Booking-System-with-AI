# Environment variables for Docker Compose deployment
# Copy this to .env in the root directory and update with your values. Do not commit .env.

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_password_here
MYSQL_DATABASE=galaxy_cinema
DB_PORT=3307
TZ=Asia/Ho_Chi_Minh

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=8080

# Frontend Build Args (public browser keys only; API URL should point to your backend)
VITE_API_URL=http://localhost:8000
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1
VITE_MAPTILER_KEY=
VITE_ORS_API_KEY=
VITE_ORS_API_KEY_2=

# Note:
# - Update MYSQL_ROOT_PASSWORD with a strong password
# - Set VITE_API_URL to the backend URL reachable from the browser (e.g., http://localhost:8000)
# - Server secrets (JWT_SECRET, SMTP, MoMo, VNPay, Pusher secret, Cloudinary) go in backend/.env
#   (see backend/.env.example); docker-compose.deploy.yml loads it with env_file.

# Optional: public HTTPS via ngrok static domain (docker-compose.ngrok.yml)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

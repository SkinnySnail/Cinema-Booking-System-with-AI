# Backend Environment Configuration
# Copy file này thành backend/.env và điền giá trị thật. KHÔNG commit backend/.env.
# Biến đặt sẵn trong môi trường (Docker, CI) được ưu tiên hơn giá trị trong file này.

# Database Configuration
DB_HOST=localhost
DB_NAME=galaxy_cinema
DB_USERNAME=root
DB_PASSWORD=change_me

# JWT Configuration
# Tạo khóa ngẫu nhiên tối thiểu 32 ký tự, ví dụ: php -r "echo bin2hex(random_bytes(32));"
# Để trống khi chạy local: backend tự sinh khóa và lưu vào backend/.jwt_secret (đã gitignore).
JWT_SECRET=
JWT_EXPIRATION=86400

# SMTP Email Configuration (Gmail App Password — xem GMAIL_SMTP_SETUP.md)
# Thiếu SMTP_USERNAME/SMTP_PASSWORD thì email chỉ được ghi vào log.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@galaxycinema.vn
SMTP_FROM_NAME=Galaxy Cinema

# MoMo (sandbox: https://developers.momo.vn/)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:8080/booking/payment
MOMO_NOTIFY_URL=

# VNPay (sandbox: https://sandbox.vnpayment.vn/)
VNP_TMNCODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_NOTIFY_URL=

# Pusher Channels (realtime trạng thái ghế / thanh toán)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# Cloudinary (poster, avatar, ảnh bắp nước)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=galaxy-cinema

# Local AI service: generate a private key and use the same value in both processes.
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=

# Application Settings
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
APP_NAME=Galaxy Cinema
APP_VERSION=1.0.0
TIMEZONE=Asia/Ho_Chi_Minh

# Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

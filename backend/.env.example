# Backend Environment Configuration
# Local AI service: generate a private key and use the same value in both processes.
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=
# Copy file này thành .env và điền thông tin thật của bạn

# Database Configuration
DB_HOST=localhost
DB_NAME=galaxy_cinema
DB_USERNAME=root
DB_PASSWORD=12345678

# JWT Configuration
JWT_SECRET=galaxy_cinema_secret_key_2026_change_this_in_production
JWT_EXPIRATION=86400

# SMTP Email Configuration (Gmail)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=taiv80527@gmail.com
SMTP_PASSWORD=oscuepstsovuwehn
SMTP_FROM_EMAIL=noreply@galaxycinema.vn
SMTP_FROM_NAME=Galaxy Cinema

# Application Settings
APP_NAME=Galaxy Cinema
APP_VERSION=1.0.0
TIMEZONE=Asia/Ho_Chi_Minh

# Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# Note: 
# - Để lấy SMTP_PASSWORD, xem hướng dẫn trong GMAIL_SMTP_SETUP.md

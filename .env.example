# ==============================================================================
# Galaxy Cinema — File biến môi trường duy nhất (.env.example -> .env)
# ==============================================================================
# Toàn bộ dự án (Docker Compose, PHP Backend, Frontend Vite, AI service, ngrok)
# đều đọc trực tiếp từ MỘT file `./.env` duy nhất ở thư mục gốc.
#
# Cách dùng:
#   1. Copy file này thành `./.env` (đã có trong .gitignore, KHÔNG commit).
#   2. Điền các key cần thiết rồi chạy `.\start-app.cmd` (Windows) hoặc `./run-dev.sh` (Linux/macOS).
# ==============================================================================


# ------------------------------------------------------------------------------
# [1] DOCKER COMPOSE & NGROK
# ------------------------------------------------------------------------------

# Public HTTPS tunnel (docker-compose.ngrok.yml)
# Lấy từ https://dashboard.ngrok.com/get-started/your-authtoken và /domains
# Lưu ý: NGROK_DOMAIN là hostname (vd: example.ngrok-free.dev), KHÔNG phải ID (rd_...).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Local Docker Compose (docker.yml)
MYSQL_ROOT_PASSWORD=
CINEMA_DB_PORT=3307
CINEMA_API_PORT=8000
CINEMA_WEB_PORT=8080

# Local AI overlay (docker-compose.ai.yml, docker-compose.ollama.yml, run-dev.sh)
AI_SERVICE_KEY=
CINEMA_AI_BUNDLE_DIR=./local-ai-tuning/workspace/chatbot-bundle

# Production / Server deploy (docker-compose.deploy.yml, .github/workflows/cd.yml)
MYSQL_DATABASE=galaxy_cinema
DB_PORT=3307
TZ=Asia/Ho_Chi_Minh
BACKEND_PORT=8000
FRONTEND_PORT=8080
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
# AI_IMAGE=
# Lưu ý: khi build frontend bằng docker-compose.deploy.yml, các biến VITE_* ở Mục [3]
# cũng được đọc từ ./.env làm Docker build args.


# ------------------------------------------------------------------------------
# [2] PHP BACKEND API
# ------------------------------------------------------------------------------

# Database (khi chạy qua docker-compose.deploy.yml đặt DB_HOST=db, DB_PORT=3306;
# khi chạy PHP trực tiếp trên host trỏ vào MySQL Docker đặt DB_HOST=127.0.0.1, DB_PORT=3307)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=galaxy_cinema
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# JWT (tối thiểu 32 ký tự; tạo nhanh: php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=
JWT_EXPIRATION=86400

# SMTP Email (Gmail App Password — thiếu username/password thì chỉ ghi log)
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@galaxycinema.vn
SMTP_FROM_NAME=Galaxy Cinema

# VNPay Payment (https://sandbox.vnpayment.vn/)
VNP_TMNCODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Để trống sẽ tự dùng APP_URL/index.php/api/transactions/vnpay/verify|ipn
# VNPAY_RETURN_URL=
# VNPAY_NOTIFY_URL=

# Pusher Channels (cập nhật realtime ghế & trạng thái thanh toán)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# AI Service
AI_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=

# Cloudinary (tùy chọn — upload poster, avatar, ảnh bắp nước)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=galaxy-cinema

# URL công khai của backend và frontend
# Local: http://localhost:8000 & http://localhost:8080
# Khi dùng ngrok / deploy: đổi cả hai sang https://<NGROK_DOMAIN> hoặc domain thật
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080


# ------------------------------------------------------------------------------
# [3] FRONTEND VITE (truyền vào container qua docker.yml & docker-compose.deploy.yml)
# ------------------------------------------------------------------------------
# Mọi biến VITE_* đều được nhúng vào bundle JS gửi xuống trình duyệt (chỉ dùng key công khai).

VITE_API_URL=http://localhost:8000
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1
VITE_MAPTILER_KEY=
VITE_ORS_API_KEY=
VITE_ORS_API_KEY_2=


# ------------------------------------------------------------------------------
# [4] LOCAL AI TUNING / SERVING (tùy chọn — export trong terminal, không tự load .env)
# ------------------------------------------------------------------------------

TUNING_DB_DSN=mysql:host=127.0.0.1;port=3307;dbname=galaxy_cinema;charset=utf8mb4
TUNING_DB_USER=
TUNING_DB_PASSWORD=
TUNING_ANON_KEY=
AI_MODEL_DIR=
AI_OLLAMA_URL=http://127.0.0.1:11434

# Copy file này thành .env (cùng thư mục) và điền giá trị thật. KHÔNG commit .env.
# Lưu ý: mọi biến VITE_* đều được nhúng vào bundle JS gửi cho trình duyệt,
# nên chỉ đặt ở đây các khóa công khai (publishable). Không đặt secret phía server.

# API Configuration
VITE_API_URL=http://localhost:8000

# Pusher Realtime (chỉ "key" công khai; PUSHER_SECRET nằm ở backend/.env)
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1

# Map Configuration (nên giới hạn domain cho các khóa này trong trang quản lý của MapTiler / OpenRouteService)
VITE_MAPTILER_KEY=
VITE_ORS_API_KEY=
VITE_ORS_API_KEY_2=
